{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/covers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/genres/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/models/t/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/models/category/kitchen/",
      "destination": "/models/category/kitchen-and-dining/",
      "permanent": true
    },
    {
      "source": "/models/category/kitchen",
      "destination": "/models/category/kitchen-and-dining/",
      "permanent": true
    },
    {
      "source": "/models/category/modern-apartment/",
      "destination": "/models/category/home-and-living/",
      "permanent": true
    },
    {
      "source": "/models/category/modern-apartment",
      "destination": "/models/category/home-and-living/",
      "permanent": true
    },
    {
      "source": "/models/category/artists-workshop/",
      "destination": "/models/category/workshop-and-power-tools/",
      "permanent": true
    },
    {
      "source": "/models/category/artists-workshop",
      "destination": "/models/category/workshop-and-power-tools/",
      "permanent": true
    },
    {
      "source": "/models/category/city-and-public-space/",
      "destination": "/models/category/city-and-street/",
      "permanent": true
    },
    {
      "source": "/models/category/city-and-public-space",
      "destination": "/models/category/city-and-street/",
      "permanent": true
    },
    {
      "source": "/models/category/creators-studio/",
      "destination": "/models/category/music-and-audio/",
      "permanent": true
    },
    {
      "source": "/models/category/creators-studio",
      "destination": "/models/category/music-and-audio/",
      "permanent": true
    }
  ]
}